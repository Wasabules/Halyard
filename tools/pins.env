# pins.env - what the Switch decoder stack is built from, in ONE place.
#
# Read by tools/build-ffmpeg-switch.sh (to build it), .github/workflows/
# build-switch.yml (which runs that script) and release.yml (to ship its source
# next to the binary, which the GPL requires: FFmpeg is built --enable-gpl
# because the nvtegra hwaccel is GPL-2.0-or-later).
#
# 2026-09-26 - these used to pin Averne's FFmpeg fork and Envideo, the
# `envideo` generation that is BROKEN on this console (5.2 s per GPU->CPU
# transfer, empty surfaces - KB.md §9, 2026-08-22). The .nro that works was
# never built from them: it links FFmpeg 7.1.5 + the nvtegra patch below, and
# contains no Envideo code at all. patches/ffmpeg/README.md.
FFMPEG_VERSION=7.1.5
FFMPEG_SHA256=de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f
# The toolchain image, dated rather than `latest`: a release built from a tag
# must be rebuildable with the same compiler next month.
DEVKITA64_IMAGE=devkitpro/devkita64:20260219
